      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst fields = (body.data && body.data.fields) || [];\nconst out = { email: '', respuesta: '', respuesta_texto: '', calificado: false, utm_source: '', utm_medium: '', utm_campaign: '', utm_content: '', utm_term: '' };\nfor (const f of fields) {\n  if (f.type === 'INPUT_EMAIL') {\n    out.email = f.value || '';\n  } else if (f.type === 'MULTIPLE_CHOICE') {\n    const id = Array.isArray(f.value) ? f.value[0] : f.value;\n    const opts = f.options || [];\n    const idx = opts.findIndex(o => o.id === id);\n    if (idx >= 0) { out.respuesta = String.fromCharCode(65 + idx); out.respuesta_texto = opts[idx].text; }\n  } else if (typeof f.label === 'string' && f.label.indexOf('utm_') === 0) {\n    out[f.label] = f.value || '';\n  }\n}\nout.calificado = ['A', 'B'].includes(out.respuesta);\nreturn [{ json: out }];"
        },
